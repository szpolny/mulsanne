index 98b7582dff68d4f4d9e0068cc77bec9d33ea4904..43953cb9973c8f3307c7233d9c123bfc6fbc224b 100644
--- a/dist/uPlot.cjs.js
+++ b/dist/uPlot.cjs.js
@@ -441,7 +441,14 @@ function _rangeNum(_min, _max, cfg) {
 }
 
 // alternative: https://stackoverflow.com/a/2254896
-const numFormatter = new Intl.NumberFormat(domEnv ? nav.language : 'en-US');
+// WebKitGTK may expose the POSIX language tag 'C', which Intl rejects.
+const numFormatter = (() => {
+	try {
+		return new Intl.NumberFormat(domEnv ? nav.language : 'en-US');
+	} catch {
+		return new Intl.NumberFormat('en-US');
+	}
+})();
 const fmtNum = val => numFormatter.format(val);
 
 const M = Math;
