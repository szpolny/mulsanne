{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mulsanne",
  "version": "../package.json",
  "identifier": "xyz.mulsanne",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mulsanne",
        "backgroundColor": "#09090b",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "decorations": false,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NzdBQjY2MDFEMDNBMTEKUldRUk90QUJacXQzUnExWkxnUmNFSFlOakRqdGVKSTFna1FXYzY5eFV4alpRcmtIUW1qVlJtOFAK",
      "endpoints": ["https://github.com/szpolny/lm-overlay/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
