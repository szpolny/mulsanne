{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mulsanne",
  "version": "0.1.0",
  "identifier": "com.lm-overlay.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mulsanne",
        "backgroundColor": "#09090b",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "decorations": false,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
