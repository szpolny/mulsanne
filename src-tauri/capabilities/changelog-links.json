{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "changelog-links",
  "description": "Allow the changelog dialog to open referenced pull requests in the default browser",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/szpolny/mulsanne/issues/*" },
        { "url": "https://github.com/szpolny/mulsanne/pull/*" }
      ]
    }
  ]
}
