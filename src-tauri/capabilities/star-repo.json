{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "star-repo",
  "description": "Allow the companion to open the GitHub repository in the default browser so users can star it",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/szpolny/mulsanne" }
      ]
    }
  ]
}
