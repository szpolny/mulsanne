{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "report-issue",
  "description": "Allow the companion to open the GitHub issue chooser in the default browser",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/szpolny/mulsanne/issues/new/choose" }
      ]
    }
  ]
}
