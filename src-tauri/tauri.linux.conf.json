{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mulsanne",
        "backgroundColor": "#09090b",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "decorations": false,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "linux": {
      "deb": {
        "depends": [
          "bash",
          "coreutils",
          "util-linux",
          "libgtk-layer-shell0"
        ],
        "files": {
          "/usr/bin/mulsanne": "../packaging/linux/launch.sh",
          "/usr/lib/mulsanne/run-lmu-bridge.sh": "../scripts/run-lmu-bridge.sh",
          "/usr/lib/mulsanne/lmu-bridge.exe": "resources/lmu-bridge.exe"
        },
        "desktopTemplate": "../packaging/linux/mulsanne.desktop"
      },
      "rpm": {
        "depends": [
          "bash",
          "coreutils",
          "util-linux",
          "gtk-layer-shell"
        ],
        "files": {
          "/usr/bin/mulsanne": "../packaging/linux/launch.sh",
          "/usr/lib/mulsanne/run-lmu-bridge.sh": "../scripts/run-lmu-bridge.sh",
          "/usr/lib/mulsanne/lmu-bridge.exe": "resources/lmu-bridge.exe"
        },
        "desktopTemplate": "../packaging/linux/mulsanne.desktop"
      }
    }
  }
}
